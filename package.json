{
  "name": "@charter-agreement-protocol/signer",
  "version": "0.2.0",
  "description": "Holder-side companion signer for the Charter Agreement Protocol (CAP) in TypeScript - key custody only: an atomic key snapshot, the sign callback, the wrong-key guard, and post-sign verification, with framing, the claims gate, the R1-R3 honest-signer refusals, and assembly all delegated to the @charter-agreement-protocol/verifier producer surface. CAP verifies; it never authorizes; this signer signs, it never verifies third-party artifacts or takes custody.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings signer.test.ts",
    "prepack": "npm run build",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "build:site": "node web/build.mjs && esbuild web/main.ts --bundle --minify --format=iife --target=es2022 --outfile=site-dist/app.js --alias:node:crypto=./web/shim/node-crypto.ts --alias:node:fs=./web/shim/node-fs.ts --alias:node:path=./web/shim/node-path.ts --inject:./web/shim/buffer-global.ts"
  },
  "dependencies": {
    "@charter-agreement-protocol/verifier": "^0.4.0"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.5.1",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baselabs/charter_agreement_signer_typescript.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
